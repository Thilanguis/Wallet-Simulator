    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "firebase": "12.6.0",
    "prettier": "3.9.10"
  }
}
