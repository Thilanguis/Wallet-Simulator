{
  "name": "findom-wallet",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "simulate": "node scripts/simulate.cjs",
    "build": "node scripts/build.cjs",
    "start": "node scripts/serve.cjs",
    "setup:local": "node scripts/setup-local.cjs",
    "test:live": "playwright test --config playwright.live.config.cjs",
    "test:firebase": "playwright test --config playwright.firebase.config.cjs",
