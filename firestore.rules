rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function accessConfig() {
      return get(/databases/$(database)/documents/usuarios/gabriel-local/config/acesso).data;
    }
    function walletMember() {
      let config = accessConfig();
      return verifiedGoogle() && config is map && config.get('emails', []) is list
        && config.emails.size() <= 2 && request.auth.token.email in config.emails;
    }
    function accessEnabled(config) {
      return config is map && config.get('emails', []) is list && config.emails.size() <= 2
        && config.get('adminEmail', '') is string && config.get('adminEmail', '') in config.emails;
    }
    function documentKey(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$') && !id.matches('^__.*__$');
    }
    function validList(list) {
      let fields = ['name', 'items', 'walletRevision', 'editedId'];
      return list.keys().hasAll(fields) && list.keys().hasOnly(fields.concat(['shareKey', 'walletPaged'])) && list.name is string
        && list.name.size() > 0 && list.name.size() <= 80 && list.items is map
        && (list.get('walletPaged', false) == false || (list.walletPaged == true && list.items.size() == 0))
        && list.walletRevision is int && list.walletRevision >= 0
        && (list.editedId == '' || documentKey(list.editedId))
        && (list.get('shareKey', '') == '' || shareToken(list.shareKey));
    }
    function validWish(id, wish) {
      let fields = ['id', 'title', 'store', 'originalPrice', 'currency', 'quantity', 'taxQuebec', 'bought'];
      return wish is map && wish.keys().hasAll(fields) && wish.keys().hasOnly(fields.concat(['url'])) && wish.id == id
        && wish.get('url', '') is string && wish.get('url', '').size() <= 4096
        && (wish.get('url', '') == '' || wish.url.matches('^https?://[^/?#@\\s]+([/?#][^\\s]*)?$'))
        && wish.title is string && wish.title.size() > 0 && wish.title.size() <= 300
        && wish.store is string && wish.store.size() <= 150
        && wish.currency is string && wish.currency.matches('^[A-Z]{3}$')
        && wish.quantity is int && wish.quantity >= 1 && wish.quantity <= 9007199254740991
        && (wish.originalPrice == null || (wish.originalPrice is number && wish.originalPrice >= 0
          && wish.originalPrice <= 90071992547409 / wish.quantity))
        && wish.taxQuebec is bool && wish.bought is bool;
    }
    function personalMutation(id, oldItems, newItems) {
      let changed = newItems.diff(oldItems).affectedKeys();
      let previous = oldItems.get(id, {'bought': false});
      return changed.size() == 1 && changed.hasOnly([id]) && previous is map
        && previous.get('bought', null) is bool
        && (!(id in newItems) || (validWish(id, newItems[id]) && newItems[id].bought == previous.bought));
    }
    function shareToken(token) {
      return token is string && token.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
    }
    function sharePath(token) {
      return /databases/$(database)/documents/wishlistShares/$(token);
    }
    function changesPersonalPurchaseStatus(oldItems, newItems, id) {
      let changed = newItems.diff(oldItems).affectedKeys();
      return documentKey(id) && changed.size() == 1 && changed.hasOnly([id])
        && id in oldItems && id in newItems
        && oldItems[id].bought is bool && newItems[id].bought is bool
        && oldItems[id].bought != newItems[id].bought
        && newItems[id].diff(oldItems[id]).affectedKeys().hasOnly(['bought']);
    }
    function sharingProfile() {
      let config = accessConfig();
      return !walletMember() || !accessEnabled(config) ? ''
        : request.auth.token.email == config.adminEmail ? 'wallet-admin' : 'primary-luana';
    }
    function ownsProfile(owner, profile) {
      return documentKey(profile) && owner == profile;
    }
    function readsPersonal(owner, profile) {
      return documentKey(profile) && (owner == profile
        || (exists(grantPath(owner, profile)) && activePersonalProfile(owner)));
    }
    function readsGrant(data, profile) {
      return documentKey(profile) && (data.owner == profile || data.recipient == profile);
    }
    function grantPath(owner, recipient) {
      let id = owner + '~' + recipient;
      return /databases/$(database)/documents/usuarios/gabriel-local/wishlistGrants/$(id);
    }
    function activePersonalProfile(id) {
      let config = accessConfig();
      return accessEnabled(config) && (id == 'wallet-admin'
        || (id == 'primary-luana' && config.emails.size() == 2));
    }
    function validPersonal(data) {
      return data.keys().hasOnly(['items', 'editedId']) && data.items is map && data.editedId is string;
    }
    function personalUpdate() {
      let next = request.resource.data;
      return validPersonal(next) && (changesPersonalPurchaseStatus(resource.data.items, next.items, next.editedId)
        || (documentKey(next.editedId) && personalMutation(next.editedId, resource.data.items, next.items)));
    }
    function walletSimulator(envelope) {
      return envelope.get('simulator', {}) is map ? envelope.get('simulator', {}) : {};
    }
    function walletEnvelope(data) {
      return data.get('walletAtualV4', {}) is map ? data.get('walletAtualV4', {}) : {};
    }
    function validWishlistStorage() {
      let before = walletEnvelope(resource.data);
      let after = walletEnvelope(request.resource.data);
      let paged = after.keys().hasAny(['wishlistPages']);
      return (!before.keys().hasAny(['wishlistPages']) || paged)
        && (!paged || (after.wishlistPages is list && after.wishlistPages.size() > 0
          && !walletSimulator(after).keys().hasAny(['wishlist']) && !after.keys().hasAny(['wishlistImages'])));
    }
    function compatibleWishlistWrite() {
      let before = walletSimulator(walletEnvelope(resource.data));
      let updatedEnvelope = walletEnvelope(request.resource.data);
      let changes = walletSimulator(updatedEnvelope).diff(before).affectedKeys();
      let revision = updatedEnvelope.get('revision', 0);
      let marker = updatedEnvelope.get('wishlistWriteRevision', 0);
      return (!changes.hasAny(['wishlist', 'wishlistPeople'])
          && updatedEnvelope.get('wishlistPages', []) == walletEnvelope(resource.data).get('wishlistPages', []))
        || (revision is int && revision > 0 && marker is int && marker == revision);
    }

    match /usuarios/gabriel-local {
      allow read: if walletMember();
      allow update: if walletMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'walletAtualV4', 'saldoDominadora', 'bonusEspecialAtivo',
          'roletaUltimoUso', 'roletaUltimoResultadoTexto', 'tarefasBloqueadas',
          'accelBoosts', 'timerTempoSegundos', 'timerValorAtual',
          'timerValorPorMinuto', 'timerAtivo', 'timerRodando', 'atualizadoEm'
        ])
        && request.resource.data.saldoDominadora is number
        && request.resource.data.bonusEspecialAtivo is bool
        && validWishlistStorage()
        && (!accessEnabled(accessConfig()) || compatibleWishlistWrite());
      allow create, delete: if false;
      match /config/acesso {
        allow read: if walletMember();
        allow write: if false;
      }
      match /config/antesFirebasePrincipalV4 {
        allow read: if walletMember();
        allow create: if walletMember();
        allow update, delete: if false;
      }
      match /config/{configId} {
        allow read: if walletMember();
        allow write: if false;
      }
      match /wishlistPages/{hash} {
        allow get: if walletMember();
        allow create: if walletMember() && hash.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['payload'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0 && request.resource.data.payload.size() <= 300000;
        allow update: if walletMember() && request.resource.data == resource.data;
      }
      match /wishlistLists/{personId} {
        // Historic wallet mirrors stay scoped to wallet managers.
        allow read: if walletMember();
        allow create, update: if walletMember() && accessEnabled(accessConfig())
          && documentKey(personId) && validList(request.resource.data);
        allow delete: if walletMember() && accessEnabled(accessConfig()) && documentKey(personId);
      }
      match /wishlistPersonal/{owner} {
        allow get: if verifiedGoogle() && readsPersonal(owner, sharingProfile());
        allow create: if verifiedGoogle() && ownsProfile(owner, sharingProfile())
          && validPersonal(request.resource.data) && documentKey(request.resource.data.editedId)
          && personalMutation(request.resource.data.editedId, {}, request.resource.data.items);
        allow update: if verifiedGoogle() && ownsProfile(owner, sharingProfile()) && personalUpdate();
      }
      match /wishlistGrants/{id} {
        function matchesGrant(data) {
          return data.keys().hasOnly(['owner', 'recipient'])
            && documentKey(data.owner) && documentKey(data.recipient)
            && data.owner != data.recipient && id == data.owner + '~' + data.recipient;
        }
        allow read: if verifiedGoogle() && readsGrant(resource.data, sharingProfile());
        allow create: if verifiedGoogle() && matchesGrant(request.resource.data)
          && ownsProfile(request.resource.data.owner, sharingProfile())
          && activePersonalProfile(request.resource.data.recipient);
        allow delete: if verifiedGoogle() && ownsProfile(resource.data.owner, sharingProfile());
      }
      match /tarefas/{taskId} { allow read, create, update: if walletMember(); allow delete: if false; }
      match /historico/{recordId} { allow read, create, update: if walletMember(); allow delete: if false; }
      match /debugRoleta/{spinId} { allow read, create, update: if walletMember(); allow delete: if false; }
      match /accelBoosts/{boostId} { allow read, create, update: if walletMember(); allow delete: if false; }
    }
    // Other paths are denied by default. Only IAM can edit the private allowlist.
  }
}
